{
  "name": "agentic-forms-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of concept: making GOV.UK Forms legible to AI agents out of the box, via one canonical form-definition -> agent-contract transform projected as both an MCP server and a REST + .well-known / JSON Schema surface.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx bin/mcp.ts",
    "rest": "tsx bin/rest.ts",
    "demo": "tsx demo/agent-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
